include LICENSE
include NOTICE
include THIRD_PARTY_NOTICES.md
include README.md
include SUPPORT.md
include pyproject.toml
recursive-include docs *.md *.png
recursive-include scripts *.py
recursive-include tests *.py
recursive-include .github/workflows *.yml *.yaml
prune build
prune dist
prune .venv
prune .git
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
include SECURITY.md CONTRIBUTING.md CODE_OF_CONDUCT.md CHANGELOG.md
recursive-include .github *.yml *.yaml *.md

recursive-include packaging *.md *.in
